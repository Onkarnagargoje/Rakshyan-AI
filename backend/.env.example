APP_NAME=SafeNest AI
ENV=dev
# Optional: git SHA or release tag — GET /health, /version, OpenAPI info.version, startup log
APP_BUILD_ID=
# CI/deploy: short SHA if .git unavailable (otherwise resolved at runtime)
# GIT_COMMIT=

# Security
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=240

# Database
DATABASE_URL=postgresql+asyncpg://safenest:safenest@localhost:5432/safenest

# Ollama (local) — improves multilingual / code-switching via regional_language agent
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
ENABLE_OLLAMA=1
OLLAMA_TIMEOUT_SEC=90

# Optional: Google Gemini (paid API) — second opinion on borderline cases (same arbiter prompt as Ollama)
# Get a key: https://aistudio.google.com/apikey
ENABLE_GEMINI=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Mobile MVP: target Android child app + parent app (see README)

# Local HF pipelines (set 0 to force rule-based)
ENABLE_TRANSFORMERS=1

# Logging
LOG_LEVEL=INFO
LOG_HASH_CHAIN_SALT=dev-only-salt

# CORS
CORS_ORIGINS=http://localhost:3000

