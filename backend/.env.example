APP_NAME=SafeNest AI
ENV=dev

# Security
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=240

# Database
DATABASE_URL=postgresql+psycopg://safenest:safenest@localhost:5432/safenest

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
ENABLE_OLLAMA=1

# Local HF pipelines (set 0 to force rule-based)
ENABLE_TRANSFORMERS=1

# Logging
LOG_LEVEL=INFO
LOG_HASH_CHAIN_SALT=dev-only-salt

# CORS
CORS_ORIGINS=http://localhost:3000

